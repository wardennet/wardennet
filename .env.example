# ╔══════════════════════════════════════════════════════════════╗
# ║           WardenNet Cloud SaaS — 环境变量配置                ║
# ╠══════════════════════════════════════════════════════════════╣
# ║  用法：cp .env.example .env  然后按环境修改                 ║
# ║  docker compose 自动从项目根目录读 .env                      ║
# ║  本地开发（python -m cloud.app.main）也会自动读 .env          ║
# ║                                                              ║
# ║  所有数值类型 → 直接写数字，不要加引号                        ║
# ║  所有开关类型 → true / false（小写）                         ║
# ╚══════════════════════════════════════════════════════════════╝


# ═══════════════════════════════════════════════════════════════
# 一、应用基础
# ═══════════════════════════════════════════════════════════════

# 运行环境: dev / staging / prod
# dev 模式开启 DEBUG 日志、简化限流、允许跨域
# prod 模式强制 HTTPS、关闭 DEBUG、JWT 严格校验
APP_ENV=dev

# DEBUG 开关
APP_DEBUG=true

# 监听地址/端口
APP_HOST=0.0.0.0
APP_PORT=8000

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# JWT 签名密钥 — 生产环境必须替换！
# 建议: openssl rand -base64 32
JWT_SECRET=please-change-this-in-production-to-something-random


# ═══════════════════════════════════════════════════════════════
# 二、PostgreSQL
# ═══════════════════════════════════════════════════════════════
#
# docker-compose 内部主机名固定为 "postgres"
# 本地直连（不走 compose）时把 DB_HOST 改成 "localhost"

DB_HOST=postgres
DB_PORT=5432
DB_USER=wardenet
DB_PASSWORD=wardenet
DB_NAME=wardenet


# ═══════════════════════════════════════════════════════════════
# 三、Redis
# ═══════════════════════════════════════════════════════════════

# Redis 开关 — 关闭后走内存模式（单机可用，多节点必须开启）
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=


# ═══════════════════════════════════════════════════════════════
# 四、安全 — 密码学防伪造（SecurityConfig）
#
# 影响: HMAC 签名时间戳窗口 / Nonce 一次性有效期 / 限流
# 一般不需要改，除非多节点时钟偏差较大
# ═══════════════════════════════════════════════════════════════

# HMAC 时间戳允许偏差（秒）
# Agent 上报时 X-Timestamp 必须在 [now-T, now+T] 范围内
# 多节点间 NTP 同步良好 → 60 足够
# 时钟偏差大或跨区域 → 可放宽到 120 或 180
SECURITY_TS_TOLERANCE=60

# Nonce 一次性有效期（秒）
# Agent 请求到消费之间不能超过此值
# 必须 >= SECURITY_TS_TOLERANCE，否则 Nonce 还没用到就过期了
SECURITY_NONCE_TTL=60

# evidence report 限流（每分钟每次 agent）
SECURITY_REPORT_RATE_LIMIT=600


# ═══════════════════════════════════════════════════════════════
# 五、威胁情报双池 / 投票 / 准入（ThreatPoolConfig）
#
# 影响: threat_votes 投票权重、双池 TTL、全局准入门槛
# 防投毒核心参数 — 直接影响云端联防的安全性
# ═══════════════════════════════════════════════════════════════

# ── 5.1 全局共享池准入门槛（spec T3-5） ──────────────────────
#
# 威胁情报要进入 threats_global（全局共享池），必须同时满足:
#   1) 独立付费租户数 >= THREAT_MIN_PAID_TENANTS
#   2) 所有付费租户 vote_weight 之和 >= THREAT_MIN_SCORE_SUM
#
# 生产环境建议:
#   - 冷启动期（付费租户少）→ MIN_PAID=2, MIN_SCORE=2.0
#   - 稳定期（付费租户多）→ MIN_PAID=3, MIN_SCORE=3.0
#   - 高危期（疑似投毒）   → MIN_PAID=5, MIN_SCORE=5.0
#   - 禁用全局池           → MIN_SCORE=999（永远进不去）

THREAT_MIN_PAID_TENANTS=2
THREAT_MIN_SCORE_SUM=2.0


# ── 5.2 租户分层权重（spec T3-2） ────────────────────────────
#
# vote_weight = plan_weight × data_source_weight
#
# free 租户: 主要写私有池，低权重（默认 0.2）
# paid 租户: 可参与全局池准入，高权重（默认 1.0）
#
# 生产可调:
#   - 降低免费影响力 → FREE=0.1
#   - 提高付费话语权 → PAID=1.5

THREAT_PLAN_WEIGHT_FREE=0.2
THREAT_PLAN_WEIGHT_PAID=1.0


# ── 5.3 数据源权重 ────────────────────────────────────────────
#
# 统一数据源权重（默认 1.0，不再硬否决）
# 所有 Agent 上报的 data_source 等权计入投票
#
# nginx_socket bonus（加分项，不是硬否决）:
#   data_source == "nginx_socket" 时，threats_private.score 额外加此值
#   生产建议 0.5 ~ 2.0，不需要就设 0

THREAT_DS_WEIGHT_DEFAULT=1.0
THREAT_NGINX_SOCKET_BONUS=0.5


# ── 5.4 TTL — 情报自动过期 ────────────────────────────────────
#
# threats_private  私有池: 24h（仅本租户可见，默认 86400）
# threats_global   全局池: 72h（跨租户共享，默认 259200）
# threat_votes     投票:   72h（同上）
#
# 可调:
#   - 情报留存更久 → PRIVATE=172800(2d), GLOBAL=604800(7d)
#   - 情报更新快 → PRIVATE=3600(1h), GLOBAL=14400(4h)

THREAT_PRIVATE_TTL_SECONDS=86400
THREAT_GLOBAL_TTL_SECONDS=259200
THREAT_VOTE_TTL_SECONDS=259200


# ── 5.5 定时聚合周期 ──────────────────────────────────────────
#
# threat_votes → threats_global 定时聚合
# 间隔越短 → 准入门禁反应越快 → 但 DB 开销更大
# 建议 300s(5min) ~ 3600s(1h)

THREAT_AGGREGATE_INTERVAL=300
