8:["$","pre",null,{"children":"# 1. 检查 cloud.enabled 是否开启\n# 2. 确认 base_url / tenant_id / agent_secret 正确\n# 3. 直接 curl 测连通性\ncurl -v https://your-cloud-api/ping\n# 4. Agent 日志里搜 auth / nonce / handshake\njournalctl -u wardennet -f | grep -i \"cloud|auth|sync\""}]
