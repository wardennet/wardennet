6:["$","pre",null,{"children":"# Nginx 配置 log_format 提取真实 IP\nlog_format wardennet_real_ip '$http_cf_connecting_ip'\n  '$http_true_client_ip'\n  '$http_x_forwarded_for'\n  '$remote_addr';\n\n# 在 server {} 里使用\naccess_log /var/log/nginx/access.log wardennet_real_ip;"}]
